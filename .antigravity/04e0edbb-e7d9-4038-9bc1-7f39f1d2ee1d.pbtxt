ame=\"w-3.5 h-3.5 text-brand-accent fill-brand-accent\" />\n            Social Media Manager Portfolio\n          </div>\n\n          {/* Name Display */}\n          <h2 className=\"font-mono text-sm font-semibold tracking-widest text-brand-accent uppercase mt-2\">\n            {settings.profileName}\n          </h2>\n\n          {/* Main Huge Tagline */}\n          <h1 className=\"font-display text-4xl sm:text-6xl lg:text-7xl tracking-tight leading-none uppercase max-w-4xl font-extrabold text-white mt-1\">\n            {settings.tagline}\n          </h1>\n\n          {/* Subheadline description */}\n          <p className=\"font-sans text-lg sm:text-xl text-white/80 font-medium max-w-3xl leading-snug mt-2\">\n            {settings.subheadline}\n          </p>\n\n          {/* Supporting targeted industries filter segment */}\n          <div className=\"border-l-4 border-brand-accent pl-4 sm:pl-6 max-w-2xl mt-2\">\n            <p className=\"font-sans text-sm sm:text-base text-white/50 font-medium leading-relaxed\">\n              {settings.supportingLine}\n            </p>\n          </div>\n\n          {/* Primary & Secondary Call to Actions */}\n          <div className=\"flex flex-wrap gap-4 sm:gap-6 mt-6\">\n            <a\n              href={mailLink}\n              className=\"px-8 py-3.5 bg-brand-accent text-white font-mono text-xs uppercase font-extrabold tracking-widest border border-white/10 transition-all duration-200 hover:bg-brand-accent/90\"\n            >\n              Hire Me\n            </a>\n            <a\n              href=\"#work\"\n              onClick={handleSeeWork}\n              className=\"px-8 py-3.5 bg-white text-black font-mono text-xs uppercase font-extrabold tracking-widest transition-all duration-200 hover:bg-white/90 flex items-center gap-2\"\n            >\n              See My Work <ArrowRight className=\"w-4 h-4 stroke-[2.5]\" />\n            </a>\n          </div>\n        </motion.div>\n\n        {/* Highlight Stats Panels */}\n        <motion.div\n          initial={{ opacity: 0, y: 30 }}\n          animate={{ opacity: 1, y: 0 }}\n          transition={{ duration: 0.7, delay: 0.3 }}\n          className=\"grid grid-cols-1 sm:grid-cols-3 gap-6 mt-16 sm:mt-24 w-full\"\n        >\n          {stats.map((stat, idx) => (\n            <div\n              key={idx}\n              className=\"border border-white/5 p-8 bg-[#111] hover:bg-[#151515] hover:border-white/15 transition-all duration-300 flex flex-col justify-between group rounded-none\"\n            >\n              <div className=\"font-display text-3xl sm:text-4xl text-brand-accent tracking-wider font-extrabold select-all\">\n                {stat.value}\n              </div>\n              <div className=\"font-mono text-[10px] uppercase tracking-widest font-semibold text-white/40 mt-4 border-t border-white/5 pt-3 flex items-center justify-between\">\n                <span>{stat.label}</span>\n                <span className=\"text-brand-accent group-hover:scale-125 transition-transform\">\342\234\246</span>\n              </div>\n            </div>\n          ))}\n        </motion.div>\n      </div>\n    </section>\n  );"
