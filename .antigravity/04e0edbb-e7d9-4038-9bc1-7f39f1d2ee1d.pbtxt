    replacement_infos {
      original_chunk {
        target_content: "    <section\n      id=\"testimonials\"\n      className=\"px-4 sm:px-6 lg:px-8 py-20 bg-brand-light-gray border-b-4 border-brand-black\"\n    >\n      <div className=\"max-w-7xl mx-auto\">\n        {/* Header Block */}\n        <div className=\"flex flex-col gap-4 mb-16 max-w-3xl\">\n          <div className=\"bg-brand-accent text-white px-3 py-1 font-mono text-xs uppercase font-bold w-fit border border-brand-black brutalist-shadow-sm select-none\">\n            What Clients Say\n          </div>\n          <h2 className=\"font-display text-4xl sm:text-5xl uppercase text-brand-black font-normal\">\n            Don\'t take my word for it.\n          </h2>\n          <p className=\"font-sans text-lg text-brand-muted font-semibold mt-1\">\n            Testimonials below can be populated using the Launch Center drawer below.\n          </p>\n        </div>\n\n        {/* Testimonials 3 columns grid */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-8\">\n          {testimonials.map((test, idx) => {\n            const hasQuote = test.quote && test.quote.trim().length > 0;\n            const hasClientName = test.clientName && test.clientName.trim().length > 0;\n            const hasRole = test.role && test.role.trim().length > 0;\n\n            const initials = hasClientName\n              ? test.clientName\n                  .split(\" \")\n                  .map((n) => n[0])\n                  .join(\"\")\n                  .toUpperCase()\n                  .slice(0, 2)\n              : initialsMap[idx];\n\n            return (\n              <div\n                key={test.id}\n                className=\"bg-white border-4 border-brand-black p-8 brutalist-shadow relative flex flex-col justify-between min-h-[340px]\"\n              >\n                {/* Huge quotation mark background accent */}\n                <Quote className=\"absolute right-6 top-6 w-16 h-16 text-brand-accent/5 fill-brand-accent/5 rotate-180 pointer-events-none select-none\" />\n\n                <div>\n                  {/* Indicator badging */}\n                  <div className=\"flex items-center justify-between border-b pb-4 mb-6 border-brand-black/10 select-none\">\n                    <span className=\"font-mono text-xs font-bold text-brand-muted uppercase\">\n                      Client Review\n                    </span>\n                    <span className=\"font-mono text-[10px] uppercase font-black text-brand-accent px-2 py-0.5 bg-brand-light-gray border border-brand-black/30\">\n                      {brandTags[idx]}\n                    </span>\n                  </div>\n\n                  {/* Quote text display */}\n                  {hasQuote ? (\n                    <p className=\"font-sans text-base sm:text-lg italic font-medium text-brand-black/90 leading-relaxed mb-8\">\n                      \"{test.quote}\"\n                    </p>\n                  ) : (\n                    // Outstanding placeholder indicator to help client know it\'s a editable slot!\n                    <div className=\"bg-brand-accent/5 border-2 border-dashed border-brand-accent/30 p-6 rounded-md mb-8\">\n                      <div className=\"flex items-start gap-2.5 text-brand-accent\">\n                        <AlertCircle className=\"w-5 h-5 flex-shrink-0 mt-0.5\" />\n                        <div>\n                          <h4 className=\"font-mono text-xs font-extrabold uppercase tracking-wider\">\n                            Testimonial Placeholder\n                          </h4>\n                          <p className=\"font-sans text-xs font-medium text-brand-muted mt-1 leading-normal\">\n                            No quote entered yet. Munachi can input real client feedback for {brandTags[idx]} using the Launch Center control panel below at any time.\n                          </p>\n                        </div>\n                      </div>\n                    </div>\n                  )}\n                </div>\n\n                {/* Client info footer row */}\n                <div className=\"flex items-center gap-4 pt-4 border-t border-brand-black/10\">\n                  {/* Avatar bubble with fallback initials */}\n                  <div className=\"w-12 h-12 rounded-full border-2 border-brand-black flex items-center justify-center font-display bg-brand-light-gray text-base text-brand-black select-none font-normal shrink-0\">\n                    {initials}\n                  </div>\n\n                  <div className=\"overflow-hidden\">\n                    {hasClientName ? (\n                      <div className=\"font-mono text-sm font-bold text-brand-black uppercase truncate\">\n                        {test.clientName}\n                      </div>\n                    ) : (\n                      <div className=\"font-mono text-xs font-black text-brand-accent flex items-center gap-1\">\n                        <Edit className=\"w-3.5 h-3.5\" /> Pending Client Name\n                      </div>\n                    )}\n\n                    {hasRole ? (\n                      <div className=\"font-sans text-xs font-semibold text-brand-muted truncate\">\n                        {test.role}\n                      </div>\n                    ) : (\n                      <div className=\"font-sans text-[10px] font-medium text-brand-muted italic uppercase select-none\">\n                        Owner / Manager, {brandTags[idx]}\n                      </div>\n                    )}\n                  </div>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n    </section>"
        replacement_content: "    <section\n      id=\"testimonials\"\n      className=\"px-4 sm:px-6 lg:px-8 py-20 bg-[#0A0A0A] border-b border-white/5\"\n    >\n      <div className=\"max-w-7xl mx-auto\">\n        {/* Header Block */}\n        <div className=\"flex flex-col gap-4 mb-16 max-w-3xl\">\n          <div className=\"bg-brand-accent text-white px-3 py-1 font-mono text-[10px] uppercase tracking-wider font-semibold w-fit border border-white/10 select-none shadow-none\">\n            What Clients Say\n          </div>\n          <h2 className=\"font-display text-4xl uppercase text-white font-extrabold\">\n            Don\'t take my word for it.\n          </h2>\n          <p className=\"font-sans text-xs sm:text-sm text-white/50 font-medium mt-1\">\n            Testimonials below can be populated using the Launch Center drawer below.\n          </p>\n        </div>\n\n        {/* Testimonials 3 columns grid */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-8\">\n          {testimonials.map((test, idx) => {\n            const hasQuote = test.quote && test.quote.trim().length > 0;\n            const hasClientName = test.clientName && test.clientName.trim().length > 0;\n            const hasRole = test.role && test.role.trim().length > 0;\n\n            const initials = hasClientName\n              ? test.clientName\n                  .split(\" \")\n                  .map((n) => n[0])\n                  .join(\"\")\n                  .toUpperCase()\n                  .slice(0, 2)\n              : initialsMap[idx];\n\n            return (\n              <div\n                key={test.id}\n                className=\"bg-[#111111] border border-white/5 hover:border-white/15 p-8 relative flex flex-col justify-between min-h-[340px] rounded-none transition-all duration-300\"\n              >\n                {/* Huge quotation mark background accent */}\n                <Quote className=\"absolute right-6 top-6 w-16 h-16 text-brand-accent/5 fill-brand-accent/5 rotate-180 pointer-events-none select-none\" />\n\n                <div>\n                  {/* Indicator badging */}\n                  <div className=\"flex items-center justify-between border-b pb-4 mb-6 border-white/10 select-none\">\n                    <span className=\"font-mono text-[10px] tracking-wider uppercase font-semibold text-white/40\">\n                      Client Review\n                    </span>\n                    <span className=\"font-mono text-[9px] uppercase font-semibold text-brand-accent px-2 py-0.5 bg-[#181818] border border-white/10\">\n                      {brandTags[idx]}\n                    </span>\n                  </div>\n\n                  {/* Quote text display */}\n                  {hasQuote ? (\n                    <p className=\"font-sans text-sm sm:text-base italic font-medium text-white/80 leading-relaxed mb-8\">\n                      \"{test.quote}\"\n                    </p>\n                  ) : (\n                    // Outstanding placeholder indicator to help client know it\'s a editable slot!\n                    <div className=\"bg-brand-accent/5 border border-dashed border-brand-accent/20 p-6 rounded-none mb-8\">\n                      <div className=\"flex items-start gap-2.5 text-brand-accent\">\n                        <AlertCircle className=\"w-5 h-5 flex-shrink-0 mt-0.5\" />\n                        <div>\n                          <h4 className=\"font-mono text-[10px] font-semibold uppercase tracking-wider\">\n                            Testimonial Placeholder\n                          </h4>\n                          <p className=\"font-sans text-[11px] text-white/40 mt-1 leading-normal\">\n                            No quote entered yet. Munachi can input real client feedback for {brandTags[idx]} using the Launch Center control panel below at any time.\n                          </p>\n                        </div>\n                      </div>\n                    </div>\n                  )}\n                </div>\n\n                {/* Client info footer row */}\n                <div className=\"flex items-center gap-4 pt-4 border-t border-white/10\">\n                  {/* Avatar bubble with fallback initials */}\n                  <div className=\"w-10 h-10 rounded-full border border-white/10 flex items-center justify-center font-display bg-[#181818] text-xs text-white select-none font-semibold shrink-0\">\n                    {initials}\n                  </div>\n\n                  <div className=\"overflow-hidden\">\n                    {hasClientName ? (\n                      <div className=\"font-mono text-xs font-bold text-white uppercase tracking-wider truncate\">\n                        {test.clientName}\n                      </div>\n                    ) : (\n                      <div className=\"font-mono text-[10px] font-semibold text-brand-accent flex items-center gap-1\">\n                        <Edit className=\"w-3.5 h-3.5\" /> Pending Client Name\n                      </div>\n                    )}\n\n                    {hasRole ? (\n                      <div className=\"font-sans text-[10px] text-white/40 truncate\">\n                        {test.role}\n                      </div>\n                    ) : (\n                      <div className=\"font-sans text-[9px] text-white/40 tracking-wider uppercase select-none\">\n                        Owner / Manager, {brandTags[idx]}\n                      </div>\n                    )}\n                  </div>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n    </section>"
