 flex items-center justify-between bg-[#0A0A0A] z-50 shrink-0\\\">\\n    <div class=\\\"text-lg font-bold tracking-tighter\\\">ORJI MUNACHI</div>\\n    <div class=\\\"flex gap-8 text-[11px] uppercase tracking-widest font-semibold text-white/50\\\">\\n      <a href=\\\"#\\\" class=\\\"hover:text-white transition-colors\\\">About</a>\\n      <a href=\\\"#\\\" class=\\\"hover:text-white transition-colors\\\">Services</a>\\n      <a href=\\\"#\\\" class=\\\"hover:text-white transition-colors\\\">Skills</a>\\n      <a href=\\\"#\\\" class=\\\"hover:text-white transition-colors\\\">Work</a>\\n      <a href=\\\"#\\\" class=\\\"hover:text-white transition-colors text-white\\\">Contact</a>\\n    </div>\\n    <button class=\\\"bg-white text-black px-6 py-2 text-[11px] font-bold uppercase tracking-widest hover:bg-white/90 transition-all\\\">\\n      Hire Me\\n    </button>\\n  </nav>\\n\\n  <!-- MAIN BENTO GRID -->\\n  <main class=\\\"flex-1 p-6 grid grid-cols-12 grid-rows-6 gap-4\\\">\\n    \\n    <!-- HERO SECTION -->\\n    <div class=\\\"col-span-8 row-span-3 bg-[#111] border border-white/5 p-10 flex flex-col justify-center relative overflow-hidden\\\">\\n      <div class=\\\"absolute top-6 left-6 text-[10px] uppercase tracking-[0.3em] text-white/30 font-bold\\\">Portfolio 2026</div>\\n      <h1 class=\\\"text-6xl font-black leading-[0.9] tracking-tight mb-6 uppercase\\\">\\n        The only social media <br/>hire you need.\\n      </h1>\\n      <p class=\\\"text-lg text-white/70 max-w-xl leading-relaxed mb-8\\\">\\n        I handle your strategy, content, ads, and analytics \342\200\224 so you stop juggling freelancers and start seeing results.\\n      </p>\\n      <div class=\\\"flex gap-10\\\">\\n        <div>\\n          <div class=\\\"text-2xl font-black\\\">10,000+</div>\\n          <div class=\\\"text-[10px] uppercase tracking-wider text-white/40\\\">Views Generated</div>\\n        </div>\\n        <div>\\n          <div class=\\\"text-2xl font-black\\\">3</div>\\n          <div class=\\\"text-[10px] uppercase tracking-wider text-white/40\\\">Industries Served</div>\\n        </div>\\n        <div>\\n          <div class=\\\"text-2xl font-black\\\">3</div>\\n          <div class=\\\"text-[10px] uppercase tracking-wider text-white/40\\\">Paying Clients</div>\\n        </div>\\n      </div>\\n    </div>\\n\\n    <!-- ABOUT SECTION -->\\n    <div class=\\\"col-span-4 row-span-4 bg-[#1A1A1A] border border-white/5 p-8 flex flex-col\\\">\\n      <div class=\\\"w-16 h-16 bg-white/5 border border-white/10 rounded-full mb-6 flex items-center justify-center text-xl font-bold tracking-tighter\\\">\\n        OM\\n      </div>\\n      <div class=\\\"text-[10px] uppercase tracking-[0.2em] text-white/40 mb-2 font-bold\\\">About Me</div>\\n      <h2 class=\\\"text-xl font-bold mb-4 leading-tight\\\">Building the online presence your business deserves.</h2>\\n      <p class=\\\"text-sm text-white/60 leading-relaxed space-y-4\\\">\\n        I\'m not the cheapest option. I\'m the one that works. I design, write, edit, and run ads. You hire one person, you get everything done properly.\\n      </p>\\n      <div class=\\\"mt-auto pt-6 border-t border-white/5\\\">\\n        <div class=\\\"text-[10px] uppercase text-white/30 mb-2\\\">Specialization</div>\\n        <div class=\\\"flex flex-wrap gap-2\\\">\\n          <span class=\\\"px-2 py-1 bg-white/5 border border-white/10 text-[9px] uppercase tracking-wider\\\">Fashion Labels</span>\\n          <span class=\\\"px-2 py-1 bg-white/5 border border-white/10 text-[9px] uppercase tracking-wider\\\">Car Dealerships</span>\\n          <span class=\\\"px-2 py-1 bg-white/5 border border-white/10 text-[9px] uppercase tracking-wider\\\">Agribusiness</span>\\n        </div>\\n      </div>\\n    </div>\\n\\n    <!-- CASE STUDY 1 -->\\n    <div class=\\\"col-span-4 row-span-3 bg-[#111] border border-white/5 p-6 flex flex-col\\\">\\n      <div class=\\\"flex justify-between items-start mb-4\\\">\\n        <span class=\\\"text-[9px] font-bold px-2 py-0.5 bg-white text-black uppercase\\\">Automotive</span>\\n        <div class=\\\"w-5 h-5 border border-white/20 flex items-center justify-center\\\">\\n          <div class=\\\"w-2 h-2 bg-white\\\"></div>\\n        </div>\\n      </div>\\n      <h3 class=\\\"text-lg font-bold leading-tight mb-2\\\">Opara Motors</h3>\\n      <p class=\\\"text-xs text-white/50 mb-4\\\">A car dealership that finally looked the part online.</p>\\n      <div class=\\\"grid grid-cols-2 gap-2 mt-auto\\\">\\n        <div class=\\\"bg-white/5 p-3 border border-white/5\\\">\\n          <div class=\\\"text-lg font-black\\\">8.4K</div>\\n          <div class=\\\"text-[8px] uppercase text-white/40\\\">Views</div>\\n        </div>\\n        <div class=\\\"bg-white/5 p-3 border border-white/5\\\">\\n          <div class=\\\"text-lg font-black\\\">1K</div>\\n          <div class=\\\"text-[8px] uppercase text-white/40\\\">Followers</div>\\n        </div>\\n      </div>\\n    </div>\\n\\n    <!-- SKILLS SECTION -->\\n    <div class=\\\"col-span-4 row-span-2 bg-[#1A1A1A] border border-white/5 p-6 flex flex-col\\\">\\n      <div class=\\\"text-[10px] uppercase tracking-widest text-white/40 mb-4 font-bold\\\">Skills & Tools</div>\\n      <div class=\\\"flex flex-col gap-3 flex-1 overflow-hidden\\\">\\n        <div class=\\\"flex items-center gap-3\\\">\\n          <div class=\\\"w-8 h-8 bg-white/5 border border-white/10 flex items-center justify-center text-[8px] font-bold\\\">CVA</div>\\n          <div class=\\\"w-8 h-8 bg-white/5 border border-white/10 flex items-center justify-center text-[8px] font-bold\\\">CPC</div>\\n          <div class=\\\"w-8 h-8 bg-white/5 border border-white/10 flex items-center justify-center text-[8px] font-bold\\\">META</div>\\n          <div class=\\\"w-8 h-8 bg-white/5 border border-white/10 flex items-center justify-center text-[8px] font-bold\\\">TTK</div>\\n          <div class=\\\"w-8 h-8 bg-white/5 border border-white/10 flex items-center justify-center text-[8px] font-bold\\\">G-AD</div>\\n        </div>\\n        <div class=\\\"text-xs text-white/60 font-medium\\\">\\n          Strategy \342\200\242 Paid Ads \342\200\242 Content Production \342\200\242 Analytics\\n        </div>\\n      </div>\\n    </div>\\n\\n    <!-- CTA / CONTACT -->\\n    <div class=\\\"col-span-4 row-span-2 bg-white p-8 flex flex-col justify-center items-center text-center\\\">\\n      <h2 class=\\\"text-black text-xl font-black uppercase mb-4 leading-tight\\\">Ready to win?</h2>\\n      <a href=\\\"mailto:orjimunachi5@gmail.com\\\" class=\\\"w-full py-4 bg-black text-white text-[11px] font-bold uppercase tracking-widest block\\\">\\n        Send an Email\\n      </a>\\n      <div class=\\\"text-black/40 text-[9px] uppercase font-bold mt-4 tracking-tighter\\\">\\n        orjimunachi5@gmail.com\\n      </div>\\n    </div>\\n\\n  </main>\\n\\n  <!-- FOOTER -->\\n  <footer class=\\\"h-12 border-t border-white/10 px-8 flex items-center justify-between text-[9px] uppercase tracking-widest text-white/40 shrink-0\\\">\\n    <div>Orji Munachi \342\200\224 2026</div>\\n    <div class=\\\"flex gap-6\\\">\\n      <span class=\\\"hover:text-white cursor-pointer transition-colors\\\">Instagram</span>\\n      <span class=\\\"hover:text-white cursor-pointer transition-colors\\\">LinkedIn</span>\\n    </div>\\n  </footer>\\n</div>\\n                    </body>\\n                  </html>\n[AIS_METADATA_SECTION_END]"
