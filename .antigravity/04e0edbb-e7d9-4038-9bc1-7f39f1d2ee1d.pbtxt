    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "@import url(\'https://fonts.googleapis.com/css2?family=Anton&family=JetBrains+Mono:wght@400;500&family=Work+Sans:wght@400;500;600;700&display=swap\');\n@import \"tailwindcss\";\n\n@theme {\n  --font-display: \"Anton\", sans-serif;\n  --font-sans: \"Work Sans\", sans-serif;\n  --font-mono: \"JetBrains Mono\", monospace;\n\n  /* Editorial Brutalism Core Color Palette */\n  --color-brand-bg: #fbf9f4;\n  --color-brand-black: #000000;\n  --color-brand-accent: #a33800; /* Rich Terracotta red-orange */\n  --color-brand-muted: #7e7576;\n  --color-brand-border: #000000;\n  --color-brand-light-gray: #f5f3ee;\n  --color-brand-gray-card: #f0eee9;\n}\n\n/* Custom Editorial Brutalist Utilities */\n@utility brutalist-shadow {\n  box-shadow: 6px 6px 0px 0px var(--color-brand-border, #000000);\n}\n\n@utility brutalist-shadow-accent {\n  box-shadow: 6px 6px 0px 0px var(--color-brand-accent, #a33800);\n}\n\n@utility brutalist-shadow-lg {\n  box-shadow: 12px 12px 0px 0px var(--color-brand-border, #000000);\n}\n\n@utility brutalist-shadow-hover {\n  transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);\n  &:hover {\n    transform: translate(-4px, -4px);\n    box-shadow: 10px 10px 0px 0px var(--color-brand-border, #000000);\n  }\n}\n\n@utility brutalist-shadow-hover-accent {\n  transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);\n  &:hover {\n    transform: translate(-4px, -4px);\n    box-shadow: 10px 10px 0px 0px var(--color-brand-accent, #a33800);\n  }\n}\n\nhtml {\n  scroll-behavior: smooth;\n  background-color: var(--color-brand-bg);\n  color: var(--color-brand-black);\n}\n\n/* Simulated fine paper film-grain texture */\n.grain-overlay {\n  position: relative;\n}\n\n.grain-overlay::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  background-image: url(\'data:image/svg+xml,%3Csvg viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\"%3E%3Cfilter id=\"noise\"%3E%3CfeTurbulence type=\"fractalNoise\" baseFrequency=\"0.65\" numOctaves=\"3\" stitchTiles=\"stitch\"/%3E%3C/filter%3E%3Crect width=\"100%25\" height=\"100%25\" filter=\"url(%23noise)\"/%3E%3C/svg%3E\');\n  opacity: 0.05;\n  pointer-events: none;\n  z-index: 10;\n}\n\n@keyframes scroll {\n  0% { transform: translateX(0); }\n  100% { transform: translateX(-50%); }\n}\n\n.animate-marquee {\n  animation: scroll 25s linear infinite;\n}\n"
