        target_content: "@theme {\n  --font-display: \"Anton\", sans-serif;\n  --font-sans: \"Work Sans\", sans-serif;\n  --font-mono: \"JetBrains Mono\", monospace;\n\n  /* Editorial Brutalism Core Color Palette */\n  --color-brand-bg: #fbf9f4;\n  --color-brand-black: #000000;\n  --color-brand-accent: #a33800; /* Rich Terracotta red-orange */\n  --color-brand-muted: #7e7576;\n  --color-brand-border: #000000;\n  --color-brand-light-gray: #f5f3ee;\n  --color-brand-gray-card: #f0eee9;\n}\n\n/* Custom Editorial Brutalist Utilities */\n@utility brutalist-shadow {\n  box-shadow: 6px 6px 0px 0px var(--color-brand-border, #000000);\n}\n\n@utility brutalist-shadow-accent {\n  box-shadow: 6px 6px 0px 0px var(--color-brand-accent, #a33800);\n}\n\n@utility brutalist-shadow-lg {\n  box-shadow: 12px 12px 0px 0px var(--color-brand-border, #000000);\n}\n\n@utility brutalist-shadow-hover {\n  transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);\n  &:hover {\n    transform: translate(-4px, -4px);\n    box-shadow: 10px 10px 0px 0px var(--color-brand-border, #000000);\n  }\n}\n\n@utility brutalist-shadow-hover-accent {\n  transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);\n  &:hover {\n    transform: translate(-4px, -4px);\n    box-shadow: 10px 10px 0px 0px var(--color-brand-accent, #a33800);\n  }\n}"
        replacement_content: "@theme {\n  --font-display: \"Work Sans\", sans-serif;\n  --font-sans: \"Work Sans\", sans-serif;\n  --font-mono: \"JetBrains Mono\", monospace;\n\n  /* Bento Grid Core Dark Color Palette */\n  --color-brand-bg: #0A0A0A;\n  --color-brand-black: #F5F5F5; /* Text becomes crisp off-white */\n  --color-brand-accent: #a33800; /* Rich dynamic accent color input */\n  --color-brand-muted: #9E9E9E; /* Clean mid-grey for reading description texts */\n  --color-brand-border: rgba(255, 255, 255, 0.1); /* Elegant subtle border in dark mode */\n  --color-brand-light-gray: #111111; /* Clean secondary backing */\n  --color-brand-gray-card: #181818; /* Rich card color for bento cells */\n}\n\n/* Custom Bento Grid Styling Utilities */\n@utility brutalist-shadow {\n  box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.5);\n  border: 1px solid rgba(255, 255, 255, 0.08);\n}\n\n@utility brutalist-shadow-accent {\n  box-shadow: 0 0 15px 0px rgba(163, 56, 0, 0.15);\n  border: 1px solid var(--color-brand-accent);\n}\n\n@utility brutalist-shadow-lg {\n  box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.7);\n  border: 1px solid rgba(255, 255, 255, 0.1);\n}\n\n@utility brutalist-shadow-hover {\n  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);\n  border: 1px solid rgba(255, 255, 255, 0.08);\n  &:hover {\n    transform: translateY(-2px);\n    border-color: rgba(255, 255, 255, 0.2);\n    background-color: #1a1a1a;\n  }\n}\n\n@utility brutalist-shadow-hover-accent {\n  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);\n  border: 1px solid rgba(255, 255, 255, 0.08);\n  &:hover {\n    transform: translateY(-2px);\n    border-color: var(--color-brand-accent);\n    box-shadow: 0 0 20px 0px rgba(163, 56, 0, 0.2);\n  }\n}\n\n@utility bento-card {\n  background-color: #111111;\n  border: 1px solid rgba(255, 255, 255, 0.06);\n  transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);\n  &:hover {\n    border-color: rgba(255, 255, 255, 0.15);\n    background-color: #161616;\n  }\n}"
