      target_content: "    <section\n      id=\"skills\"\n      className=\"px-4 sm:px-6 lg:px-8 py-20 bg-brand-light-gray border-b-4 border-brand-black\"\n    >\n      <div className=\"max-w-7xl mx-auto\">\n        {/* Header Segment */}\n        <div className=\"flex flex-col gap-4 mb-16 max-w-3xl\">\n          <div className=\"bg-brand-accent text-white px-3 py-1 font-mono text-xs uppercase font-bold w-fit border border-brand-black brutalist-shadow-sm select-none\">\n            Skills and Tools\n          </div>\n          <h2 className=\"font-display text-4xl sm:text-5xl uppercase text-brand-black font-normal\">\n            I come equipped. No learning on the job.\n          </h2>\n          <p className=\"font-sans text-lg sm:text-xl text-brand-muted font-semibold mt-1\">\n            Every tool I use, I use properly. Every skill I list, I can prove.\n          </p>\n        </div>\n\n        {/* Top Half: 4 Skill Pillars */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-20\">\n          {pillars.map((pillar, index) => (\n            <div\n              key={pillar.title}\n              className=\"bg-white border-4 border-brand-black p-6 brutalist-shadow flex flex-col justify-between\"\n            >\n              <div>\n                <span className=\"font-mono text-xs font-bold text-brand-accent border border-brand-black px-2 py-0.5 uppercase\">\n                  Pillar 0{index + 1}\n                </span>\n                <h3 className=\"font-display text-xl uppercase mt-4 mb-2 text-brand-black\">\n                  {pillar.title}\n                </h3>\n                <p className=\"font-sans text-sm text-brand-muted font-medium leading-relaxed\">\n                  {pillar.description}\n                </p>\n              </div>\n              <div className=\"border-t border-brand-black/20 mt-6 pt-3 font-mono text-xs text-brand-accent uppercase font-bold tracking-wider\">\n                Full Competency\n              </div>\n            </div>\n          ))}\n        </div>\n\n        {/* Divider text brand strip banner */}\n        <div className=\"w-full bg-brand-black py-3 mb-16 border-2 border-brand-black text-center flex justify-around select-none\">\n          <span className=\"font-mono text-xs font-bold text-white tracking-widest uppercase\">\n            Meta Partner Certified\n          </span>\n          <span className=\"font-mono text-xs font-semibold text-brand-accent\">\342\234\246</span>\n          <span className=\"font-mono text-xs font-bold text-white tracking-widest uppercase\">\n            Data-Backed Workflows\n          </span>\n          <span className=\"font-mono text-xs font-semibold text-brand-accent\">\342\234\246</span>\n          <span className=\"font-mono text-xs font-bold text-white tracking-widest uppercase\">\n            Physical Product Specialists\n          </span>\n        </div>\n\n        {/* Bottom Half: Categorized Tool Grid */}\n        <div className=\"flex flex-col gap-8\">\n          <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6\">\n            <h3 className=\"font-display text-2xl uppercase text-brand-black\">\n              Software Stack\n            </h3>\n\n            {/* Category Filter Pills */}\n            <div className=\"flex flex-wrap gap-2\">\n              {categories.map((cat) => (\n                <button\n                  key={cat.key}\n                  onClick={() => setActiveCategory(cat.key)}\n                  className={`px-4 py-1.5 font-mono text-xs uppercase font-bold border-2 border-brand-black transition-all ${\n                    activeCategory === cat.key\n                      ? \"bg-brand-accent text-white\"\n                      : \"bg-white text-brand-black hover:bg-brand-light-gray\"\n                  } brutalist-shadow-sm cursor-pointer`}\n                >\n                  {cat.label}\n                </button>\n              ))}\n            </div>\n          </div>\n\n          {/* Tools Grid displaying genuine SVG brand logos */}\n          <div className=\"grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-6 gap-6\">\n            {filteredTools.map((tool) => {\n              const [hovered, setHovered] = useState(false);\n              return (\n                <div\n                  key={tool.name}\n                  onMouseEnter={() => setHovered(true)}\n                  onMouseLeave={() => setHovered(false)}\n                  className=\"bg-white border-2 border-brand-black p-6 flex flex-col items-center justify-center text-center brutalist-shadow-hover transition-transform group\"\n                >\n                  <div className=\"mb-4 text-brand-black flex items-center justify-center h-14\">\n                    {renderToolLogo(tool.iconKey, hovered)}\n                  </div>\n                  <div className=\"font-mono text-xs font-bold text-brand-black uppercase select-none\">\n                    {tool.name}\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n      </div>\n    </section>"
      replacement_content: "    <section\n      id=\"skills\"\n      className=\"px-4 sm:px-6 lg:px-8 py-20 bg-[#0A0A0A] border-b border-white/5\"\n    >\n      <div className=\"max-w-7xl mx-auto\">\n        {/* Header Segment */}\n        <div className=\"flex flex-col gap-4 mb-16 max-w-3xl\">\n          <div className=\"bg-brand-accent text-white px-3 py-1 font-mono text-[10px] uppercase tracking-wider font-semibold w-fit border border-white/10 select-none shadow-none\">\n            Skills and Tools\n          </div>\n          <h2 className=\"font-display text-4xl uppercase text-white font-extrabold\">\n            I come equipped. No learning on the job.\n          </h2>\n          <p className=\"font-sans text-base sm:text-lg text-white/50 font-medium mt-1\">\n            Every tool I use, I use properly. Every skill I list, I can prove.\n          </p>\n        </div>\n\n        {/* Top Half: 4 Skill Pillars */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-20\">\n          {pillars.map((pillar, index) => (\n            <div\n              key={pillar.title}\n              className=\"bg-[#111111] border border-white/5 hover:border-white/15 p-6 transition-all duration-300 flex flex-col justify-between rounded-none\"\n            >\n              <div>\n                <span className=\"font-mono text-[9px] font-semibold text-brand-accent border border-brand-accent/20 px-2 py-0.5 uppercase tracking-wider bg-brand-accent/5\">\n                  Pillar 0{index + 1}\n                </span>\n                <h3 className=\"font-display text-lg uppercase mt-4 mb-2 text-white font-bold\">\n                  {pillar.title}\n                </h3>\n                <p className=\"font-sans text-xs sm:text-sm text-white/60 font-medium leading-relaxed\">\n                  {pillar.description}\n                </p>\n              </div>\n              <div className=\"border-t border-white/5 mt-6 pt-3 font-mono text-[10px] tracking-widest text-brand-accent uppercase font-semibold\">\n                Full Competency\n              </div>\n            </div>\n          ))}\n        </div>\n\n        {/* Divider text brand strip banner */}\n        <div className=\"w-full bg-[#111111] py-4 mb-16 border border-white/10 text-center flex flex-col sm:flex-row justify-around gap-2 select-none\">\n          <span className=\"font-mono text-[10px] tracking-widest font-semibold text-white/60 uppercase\">\n            Meta Partner Certified\n          </span>\n          <span className=\"font-mono text-[10px] tracking-widest font-semibold text-brand-accent hidden sm:inline\">\342\234\246</span>\n          <span className=\"font-mono text-[10px] tracking-widest font-semibold text-white/60 uppercase\">\n            Data-Backed Workflows\n          </span>\n          <span className=\"font-mono text-[10px] tracking-widest font-semibold text-brand-accent hidden sm:inline\">\342\234\246</span>\n          <span className=\"font-mono text-[10px] tracking-widest font-semibold text-white/60 uppercase\">\n            Physical Product Specialists\n          </span>\n        </div>\n\n        {/* Bottom Half: Categorized Tool Grid */}\n        <div className=\"flex flex-col gap-8\">\n          <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6\">\n            <h3 className=\"font-display text-xl uppercase text-white font-extrabold\">\n              Software Stack\n            </h3>\n\n            {/* Category Filter Pills */}\n            <div className=\"flex flex-wrap gap-2\">\n              {categories.map((cat) => (\n                <button\n                  key={cat.key}\n                  onClick={() => setActiveCategory(cat.key)}\n                  className={`px-4 py-1.5 font-mono text-[10px] tracking-wider uppercase font-semibold border transition-all ${\n                    activeCategory === cat.key\n                      ? \"bg-brand-accent text-white border-brand-accent\"\n                      : \"bg-[#111] text-white/60 border-white/10 hover:bg-[#161616] hover:text-white\"\n                  } rounded-none cursor-pointer`}\n                >\n                  {cat.label}\n                </button>\n              ))}\n            </div>\n          </div>\n\n          {/* Tools Grid displaying genuine SVG brand logos */}\n          <div className=\"grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-6 gap-6\">\n            {filteredTools.map((tool) => {\n              const [hovered, setHovered] = useState(false);\n              return (\n                <div\n                  key={tool.name}\n                  onMouseEnter={() => setHovered(true)}\n                  onMouseLeave={() => setHovered(false)}\n                  className=\"bg-[#111111] border border-white/5 hover:border-white/15 p-6 flex flex-col items-center justify-center text-center transition-all duration-300 group rounded-none\"\n                >\n                  <div className=\"mb-4 text-white flex items-center justify-center h-14\">\n                    {renderToolLogo(tool.iconKey, hovered)}\n                  </div>\n                  <div className=\"font-mono text-[10px] tracking-widest font-semibold text-white/50 group-hover:text-white uppercase select-none transition-colors\">\n                    {tool.name}\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n      </div>\n    </section>"
